{
  "name": "nicoview-app",
  "version": "0.19.40",
  "description": "electron製のニコニコ動画閲覧アプリ",
  "main": "src/main.js",
  "scripts": {
    "dev": "electron . --dev --mock_server",
    "preview": "electron . --dev",
    "start-server": "node ./__mock_server__/server.js",
    "main": "electron .",
    "eslint": "eslint ./src/**/*.js ./src/public/*.html ./__tests__/**/*.js ./test/public/*.js ./test/public/*.html || exit 0",
    "test": "ava -v -s",
    "build": "electron-builder --x64 --dir",
    "build-zip": "electron-builder --x64"
  },
  "author": "y836475809",
  "license": "MIT",
  "devDependencies": {
    "ava": "^5.3.1",
    "electron": "^29.1.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-html": "^8.0.0",
    "nock": "^13.5.4",
    "sinon": "^17.0.1"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.4.2",
    "cheerio": "^1.0.0-rc.12",
    "electron-log": "^4.4.8",
    "hls.js": "^1.6.15",
    "riot": "^9.1.4",
    "sql.js": "^1.8.0"
  },
  "build": {
    "appId": "y836475809.app.nicoview-app",
    "directories": {
      "output": "./build"
    },
    "files": [
      "./src/**/*",
      "./icon/**/*"
    ],
    "extraResources": [
      {
        "from": "./src/css/user.css",
        "to": "user.css"
      }
    ],
    "win": {
      "icon": "./icon/icon.png",
      "target": "zip",
      "sign": null,
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    }
  },
  "ava": {
    "files": [
      "__tests__/*.test.js"
    ],
    "environmentVariables": {
      "user_agent": "unit test"
    }
  }
}
