{
    "compilerOptions": {
      "target": "ESNext",
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "allowSyntheticDefaultImports": true,
      "strict": true,
      "checkJs": true,
      "skipLibCheck": true,
      "paths": {
        "@/*": ["./*"],
        "@lib/*": ["./src/lib/*"],
        "@renderer/*": ["./src/renderer/src/*"],
      }
    },
    "include": [
      "src/**/*",
      "types/**/*.d.ts"
    ],
    "exclude": [ 
      "node_modules", 
      "dist",
      "dist-electron",
      "data", 
      "build", 
      "tmp" 
    ]
  }
  