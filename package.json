{
  "name": "nicoview-app",
  "version": "0.19.40",
  "description": "electron製のニコニコ動画閲覧アプリ",
  "main": "./out/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev -- --dev --mock_server",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "start-server": "node ./__mock_server__/server.js",
    "main": "electron .",
    "eslint": "eslint ./src/**/*.js ./src/public/*.html ./__tests__/**/*.js ./test/public/*.js ./test/public/*.html || exit 0",
    "test": "ava -v -s",
    "build:win": "electron-vite build && electron-builder --win --dir",
    "build-zip": "electron-builder --x64"
  },
  "author": "y836475809",
  "license": "MIT",
  "devDependencies": {
    "@riotjs/compiler": "^10.0.4",
    "ava": "^5.3.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.17.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-config-riot": "^6.0.1",
    "eslint-plugin-html": "^8.2.1",
    "nock": "^13.5.4",
    "rollup-plugin-riot": "^10.0.0",
    "sinon": "^17.0.1",
    "vite": "^7.3.7"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.4.2",
    "cheerio": "^1.2.0",
    "electron-log": "^4.4.8",
    "hls.js": "1.6.15",
    "mitt": "^3.0.1",
    "riot": "^9.1.4",
    "sql.js": "^1.8.0"
  },
  "build": {
    "appId": "y836475809.app.nicoview-app",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon/icon.ico",
      "signExecutable": false,
      "verifyUpdateCodeSignature": false
    }
  },
  "ava": {
    "files": [
      "__tests__/*.test.js"
    ],
    "environmentVariables": {
      "user_agent": "unit test"
    }
  }
}
