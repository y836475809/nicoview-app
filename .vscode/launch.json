{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Electron: Main",
            "cwd": "${workspaceRoot}",
            "outputCapture": "std",
            "runtimeExecutable": "electron-vite",
            "args": [
                "dev",
                "--sourcemap",
                "--",
                "--no-sandbox",
                "--remote-debugging-port=9222",
                "--dev",
                "--mock_server"
            ]
        },
        {
            "name": "Electron: Renderer",
            "type": "chrome",
            "request": "attach",
            "port": 9222,
            "webRoot": "${workspaceFolder}/src/renderer",
            "outputCapture": "std",
            "timeout": 60000,
            "sourceMaps": true,
            "presentation": {
                "hidden": true
            }
        },
        {
            "type": "node",
            "request": "launch",
            "name": "MockServer",
            "cwd": "${workspaceRoot}",
            "outputCapture": "std",
            "program": "${workspaceFolder}/__mock_server__/server.js",
            "sourceMaps": true,
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Debug AVA test file",
            "cwd": "${workspaceRoot}",
            "program": "${workspaceFolder}/node_modules/ava/entrypoints/cli.mjs",
            "args": [
                "--break",
                "--serial",
                "${file}"
            ],
            "outputCapture": "std",
            "skipFiles": [
              "<node_internals>/**/*.js"
            ]
        }
    ],
    "compounds": [
        {
            "name": "Electron: All",
            "configurations": [
                "MockServer",
                "Electron: Main",
                "Electron: Renderer",
            ],
            "presentation": {
                "order": 1
            },
            "stopAll": true
        }
    ]
}